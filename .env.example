# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=info

# Auth
# Set GATEWAY_API_KEY to enable gateway-level authentication
# Clients will authenticate with this key instead of their DeepSeek key
GATEWAY_API_KEY=
# If GATEWAY_API_KEY is not set, client keys are forwarded to DeepSeek
GATEWAY_API_KEY_FORWARDING=true

# Streaming
GATEWAY_STREAM_TIMEOUT=300
GATEWAY_PING_INTERVAL=15

# Rate Limiting
GATEWAY_RATE_LIMIT_RPM=60
GATEWAY_RATE_LIMIT_TPM=100000

# Reasoning handling for OpenAI Chat (drop|prepend|custom_field)
GATEWAY_REASONING_MODE=drop
GATEWAY_REASONING_PREPEND_MARKER=<think>